{
  "name": "pet-adoption-thesis",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:matching\"",
    "dev:frontend": "cd nextjs-frontend && npm run dev",
    "dev:backend": "cd api-backend && php artisan serve",
    "dev:matching": "cd microservice && .venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8001"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}